# MongoDB — string de ligação (MongoDB Atlas)
MONGODB_URI="mongodb+srv://utilizador:password@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="meridie"

# Nodemailer — SMTP para envio do formulário de contacto
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="o-teu-email@gmail.com"
SMTP_PASS="a-tua-app-password"

# Email que recebe as mensagens do formulário
CONTACT_TO="geral@meridie.pt"

# URL público do site (links nos emails). Ex.: https://www.meridieinvestments.com
SITE_URL="https://www.meridieinvestments.com"
# O mesmo URL, visível no browser (SEO: sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL="https://www.meridieinvestments.com"

# Google Analytics 4 (opcional) — ID de medição G-XXXXXXX
NEXT_PUBLIC_GA_ID=""

# Backoffice — emails com acesso de administrador (separados por vírgula)
ADMIN_EMAILS="admin@meridieinvestments.com"
# Password global do backoffice (usa uma longa e aleatória)
ADMIN_PASSWORD="muda-isto"

# Vercel Blob — token de escrita para o upload de imagens no backoffice
BLOB_READ_WRITE_TOKEN=""

# Anthropic (Claude) — análise comparativa e tradução automática PT → EN
ANTHROPIC_API_KEY=""
# Só para testes locais sem chave: 1 = tradução simulada ("EN: …"). Deixar vazio em produção.
TRADUCAO_SIMULADA=""

# Segredo da prova anti-bot do formulário de contacto (opcional; sem ele é derivado
# de outro segredo do servidor). Ex.: gera com `openssl rand -hex 32`.
CONTACTO_SEGREDO=""

# Stripe (conta da Meridie, Portugal) — pagamentos das reservas do Alojamento Local
# e transferências aos proprietários (Connect). Sem estas duas, as reservas
# continuam a funcionar sem pagamento online.
# Chave secreta: Stripe → Developers → API keys (sk_live_… ou sk_test_… para testes).
STRIPE_SECRET_KEY=""
# Segredo do webhook: Stripe → Developers → Webhooks → endpoint
# https://www.meridieinvestments.com/api/pagamentos/webhook/stripe com os eventos
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired e charge.refunded.
STRIPE_WEBHOOK_SECRET=""
# Casas no Brasil a cobrar também pelo Stripe português (cartões internacionais,
# sem Pix nem parcelas). Vazio = sem pagamento online no Brasil até haver Mercado Pago.
PAGAMENTOS_BR=""
